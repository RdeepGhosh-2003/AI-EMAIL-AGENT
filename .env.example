# ============================================================
# AI Email Agent — Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!
# ============================================================

# AI Keys (fill in whichever model you chose in config.yaml)
OPENROUTER_API_KEY=
# Optional app attribution URL sent to OpenRouter:
OPENROUTER_APP_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Microsoft Graph (for Outlook)
# Register a desktop app in Microsoft Entra with redirect URI http://localhost.
# Use delegated Mail.ReadWrite and Mail.Send permissions (no client secret).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
ALLOWED_OUTLOOK_DOMAINS=durgabrgs.com

# Local Dashboard Security
# Set from Agent Settings, not by hand. Stored here so it never goes to GitHub.
DASHBOARD_PIN_SECURITY=false
DASHBOARD_PIN_HASH=
DASHBOARD_COOKIE_SECURE=false

# Optional: allow private-network dashboard hostnames, e.g. MD-PC.tailnet-name.ts.net
# Keep blank for localhost-only access.
DASHBOARD_ALLOWED_HOSTS=
